<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Function rooms -->
    <record id="view_function_room_list" model="ir.ui.view">
        <field name="name">hotel.function.room.list</field>
        <field name="model">hotel.function.room</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="property_id"/>
                <field name="capacity"/>
                <field name="day_rate"/>
                <field name="product_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_function_room" model="ir.actions.act_window">
        <field name="name">Function Rooms</field>
        <field name="res_model">hotel.function.room</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Event bookings -->
    <record id="view_event_booking_list" model="ir.ui.view">
        <field name="name">hotel.event.booking.list</field>
        <field name="model">hotel.event.booking</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'"
                  decoration-muted="state in ('cancelled','invoiced')">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="function_room_id"/>
                <field name="start_datetime"/>
                <field name="pax"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_event_booking_calendar" model="ir.ui.view">
        <field name="name">hotel.event.booking.calendar</field>
        <field name="model">hotel.event.booking</field>
        <field name="arch" type="xml">
            <calendar string="Events" date_start="start_datetime"
                      date_stop="end_datetime" color="function_room_id" mode="month">
                <field name="title"/>
                <field name="function_room_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_event_booking_form" model="ir.ui.view">
        <field name="name">hotel.event.booking.form</field>
        <field name="model">hotel.event.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Completed"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_invoice" type="object" string="Invoice"
                            class="btn-primary"
                            invisible="state not in ('done','confirmed') or move_id"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled','invoiced')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="partner_id"/>
                            <field name="event_type"/>
                            <field name="function_room_id"/>
                            <field name="setup_style"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="pax"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_event_booking" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">hotel.event.booking</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
