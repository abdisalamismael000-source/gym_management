<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_property_list" model="ir.ui.view">
        <field name="name">hotel.property.list</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="room_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_property_form" model="ir.ui.view">
        <field name="name">hotel.property.form</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Grand Vista Hotel"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="room_count"/>
                        </group>
                    </group>
                    <field name="room_ids">
                        <list>
                            <field name="name"/>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">hotel.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Channels -->
    <record id="view_hotel_channel_list" model="ir.ui.view">
        <field name="name">hotel.channel.list</field>
        <field name="model">hotel.channel</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="commission_pct"/>
            </list>
        </field>
    </record>

    <record id="action_hotel_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">hotel.channel</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
