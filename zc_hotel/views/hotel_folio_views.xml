<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_folio_list" model="ir.ui.view">
        <field name="name">hotel.folio.list</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="room_id"/>
                <field name="amount_total"/>
                <field name="amount_due"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_folio_form" model="ir.ui.view">
        <field name="name">hotel.folio.form</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_invoice" type="object"
                            string="Invoice Folio" class="btn-primary"
                            invisible="state in ('invoiced','closed') or amount_total == 0"/>
                    <button name="%(action_report_folio)d" type="action"
                            string="Print Folio"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,checked_out,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="reservation_id"/>
                            <field name="room_id"/>
                        </group>
                        <group>
                            <field name="deposit_amount"/>
                            <field name="amount_total"/>
                            <field name="amount_invoiced"/>
                            <field name="amount_due"/>
                            <field name="balance_due"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Charges">
                            <field name="charge_line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="charge_type"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoices">
                            <field name="move_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_folio" model="ir.actions.act_window">
        <field name="name">Folios</field>
        <field name="res_model">hotel.folio</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
