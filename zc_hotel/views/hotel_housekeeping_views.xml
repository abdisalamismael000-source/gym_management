<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_housekeeping_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.kanban</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong>Room <field name="room_id"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="task_type"/>
                            </div>
                            <div>
                                <i class="fa fa-user me-1"/><field name="employee_id"/>
                            </div>
                            <div>
                                <i class="fa fa-calendar me-1"/><field name="scheduled_date"/>
                                <field name="priority" widget="priority" class="float-end"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_housekeeping_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.list</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('done','cancelled')">
                <field name="scheduled_date"/>
                <field name="room_id"/>
                <field name="task_type"/>
                <field name="employee_id"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'todo'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="todo,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="task_type"/>
                            <field name="reservation_id"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="scheduled_date"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_housekeeping" model="ir.actions.act_window">
        <field name="name">Housekeeping</field>
        <field name="res_model">hotel.housekeeping</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
