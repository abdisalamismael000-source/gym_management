<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Room Type -->
    <record id="view_hotel_room_type_list" model="ir.ui.view">
        <field name="name">hotel.room.type.list</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="list_price"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Deluxe Double"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="capacity"/>
                            <field name="amenity_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooms">
                            <field name="room_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="floor"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rate Plans">
                            <field name="rate_plan_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="board_type"/>
                                    <field name="min_stay"/>
                                    <field name="price"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Room -->
    <record id="view_hotel_room_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'dirty'"
                       decoration-danger="state == 'out_of_service'"/>
                <field name="current_reservation_id"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_available" type="object"
                            string="Mark Available" class="btn-primary"
                            invisible="state == 'available'"/>
                    <button name="action_set_out_of_service" type="object"
                            string="Out of Service"
                            invisible="state == 'out_of_service'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,occupied,dirty"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="floor"/>
                            <field name="current_reservation_id"/>
                            <field name="current_guest_id"/>
                        </group>
                    </group>
                    <group string="Amenities">
                        <field name="amenity_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong>Room <field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="room_type_id"/>
                            </div>
                            <div>
                                <i class="fa fa-user me-1"/><field name="current_guest_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
