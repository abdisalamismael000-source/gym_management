<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_registration_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="res">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Guest Registration Card</h2>
                        <p class="text-center text-muted"><span t-field="res.name"/></p>
                        <table class="table table-sm mt-4">
                            <tr>
                                <th style="width:30%">Guest Name</th>
                                <td><span t-field="res.partner_id"/></td>
                            </tr>
                            <tr>
                                <th>ID Type / Number</th>
                                <td>
                                    <span t-field="res.partner_id.id_type"/>
                                    <span t-field="res.partner_id.id_number"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Nationality</th>
                                <td><span t-field="res.partner_id.nationality_id"/></td>
                            </tr>
                            <tr>
                                <th>Room / Type</th>
                                <td>
                                    <span t-field="res.room_id"/> —
                                    <span t-field="res.room_type_id"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Check-in / Check-out</th>
                                <td>
                                    <span t-field="res.check_in"/> →
                                    <span t-field="res.check_out"/>
                                    (<span t-field="res.nights"/> nights)
                                </td>
                            </tr>
                            <tr>
                                <th>Occupancy</th>
                                <td>
                                    <span t-field="res.adults"/> adult(s),
                                    <span t-field="res.children"/> child(ren)
                                </td>
                            </tr>
                            <tr>
                                <th>Board</th>
                                <td><span t-field="res.board_type"/></td>
                            </tr>
                        </table>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>_____________________________</p>
                                <p>Guest Signature</p>
                            </div>
                            <div class="col-6 text-end">
                                <p>_____________________________</p>
                                <p>Front Desk</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
