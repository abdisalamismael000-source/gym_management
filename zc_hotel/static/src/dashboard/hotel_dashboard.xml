<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zc_hotel.HotelDashboard">
        <div class="o_hotel_dashboard">
            <div t-if="state.loading" class="o_hg_loading"><i class="fa fa-spinner fa-spin fa-2x"/></div>
            <div t-else="" class="o_hg_inner">

                <!-- Header -->
                <div class="o_hg_head">
                    <div>
                        <h1 class="o_hg_title o_hg_serif">Front Desk</h1>
                        <p class="o_hg_sub">Overview of today's operations · <t t-esc="state.data.company_name"/> · <t t-esc="state.data.today_label"/></p>
                    </div>
                    <div class="o_hg_head_actions">
                        <button class="o_hg_btn" t-on-click="() => this.loadData()"><i class="fa fa-refresh me-1"/>Refresh</button>
                        <button class="o_hg_btn o_hg_btn_gold" t-on-click="() => this.newReservation()"><i class="fa fa-plus me-1"/>New Reservation</button>
                    </div>
                </div>

                <!-- KPI row -->
                <div class="o_hg_kpirow">
                    <div class="o_hg_card o_hg_kpi">
                        <div class="o_hg_kpitop">
                            <span class="o_hg_tile"><i class="fa fa-money"/></span>
                            <span class="o_hg_chip" t-att-class="deltaClass(state.data.delta_revenue)" t-esc="deltaText(state.data.delta_revenue)"/>
                        </div>
                        <div class="o_hg_kval" t-esc="money(state.data.total_revenue)"/>
                        <div class="o_hg_klabel">Total Revenue (MTD)</div>
                    </div>
                    <div class="o_hg_card o_hg_kpi">
                        <div class="o_hg_kpitop">
                            <span class="o_hg_tile"><i class="fa fa-bed"/></span>
                            <span class="o_hg_chip o_hg_flat">ADR <t t-esc="money(state.data.adr)"/></span>
                        </div>
                        <div class="o_hg_kval"><t t-esc="state.data.occupancy_rate"/>%</div>
                        <div class="o_hg_klabel">Occupancy · RevPAR <t t-esc="money(state.data.revpar)"/></div>
                    </div>
                    <div class="o_hg_card o_hg_kpi">
                        <div class="o_hg_kpitop">
                            <span class="o_hg_tile"><i class="fa fa-calendar-check-o"/></span>
                            <span class="o_hg_chip" t-att-class="deltaClass(state.data.delta_arrivals)" t-esc="deltaText(state.data.delta_arrivals)"/>
                        </div>
                        <div class="o_hg_kval" t-esc="state.data.active_reservations"/>
                        <div class="o_hg_klabel">Active Reservations</div>
                    </div>
                    <div class="o_hg_card o_hg_kpi">
                        <div class="o_hg_kpitop">
                            <span class="o_hg_tile"><i class="fa fa-users"/></span>
                            <span class="o_hg_chip o_hg_flat">now</span>
                        </div>
                        <div class="o_hg_kval" t-esc="state.data.in_house"/>
                        <div class="o_hg_klabel">Guests In-House</div>
                    </div>
                </div>

                <!-- Revenue + donut -->
                <div class="o_hg_grid2">
                    <div class="o_hg_card o_hg_pad">
                        <div class="o_hg_rowbtw">
                            <div><h3 class="o_hg_ctitle o_hg_serif">Revenue — Last 7 Days</h3><p class="o_hg_csub">Room revenue per day</p></div>
                            <button class="o_hg_btn" t-on-click="() => this.openReservations()">Full report <i class="fa fa-arrow-right ms-1"/></button>
                        </div>
                        <t t-set="rc" t-value="revenueChart"/>
                        <svg class="o_hg_areachart" t-att-viewBox="'0 0 ' + rc.W + ' ' + rc.H" preserveAspectRatio="none">
                            <defs><linearGradient id="hgRev" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" class="o_hg_area_top"/><stop offset="1" class="o_hg_area_bot"/>
                            </linearGradient></defs>
                            <path t-att-d="rc.area" fill="url(#hgRev)"/>
                            <polyline t-att-points="rc.line" class="o_hg_area_line"/>
                            <circle t-att-cx="rc.last[0]" t-att-cy="rc.last[1]" r="4" class="o_hg_area_dot"/>
                        </svg>
                        <div class="o_hg_xaxis">
                            <span t-foreach="rc.labels" t-as="lbl" t-key="lbl_index" t-esc="lbl"/>
                        </div>
                    </div>

                    <div class="o_hg_card o_hg_pad">
                        <h3 class="o_hg_ctitle o_hg_serif">Room Status</h3><p class="o_hg_csub">Live inventory breakdown</p>
                        <div class="o_hg_donutwrap">
                            <svg class="o_hg_donut" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="40" class="o_hg_donut_track"/>
                                <t t-foreach="donutSegments" t-as="seg" t-key="seg_index">
                                    <circle cx="50" cy="50" r="40" fill="none" stroke-width="13"
                                            t-att-stroke="seg.color" t-att-stroke-dasharray="seg.dash"
                                            t-att-stroke-dashoffset="seg.offset" transform="rotate(-90 50 50)"/>
                                </t>
                                <text x="50" y="47" class="o_hg_donut_num" t-esc="state.data.sellable_rooms"/>
                                <text x="50" y="60" class="o_hg_donut_cap">Rooms</text>
                            </svg>
                            <div class="o_hg_legend">
                                <div class="o_hg_legrow" t-foreach="state.data.status_breakdown" t-as="s" t-key="s_index">
                                    <span class="o_hg_dot" t-attf-style="background-color: {{ s.color }};"/>
                                    <span class="o_hg_leglabel" t-esc="s.label"/>
                                    <span class="o_hg_legval" t-esc="s.value"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Worklists -->
                <div class="o_hg_grid3">
                    <!-- arrivals / departures -->
                    <div class="o_hg_card o_hg_pad">
                        <div class="o_hg_sectlabel o_hg_serif o_hg_green"><i class="fa fa-sign-in me-1"/>Arrivals Today <span class="o_hg_count" t-esc="state.data.arrivals.length"/></div>
                        <div t-if="!state.data.arrivals.length" class="o_hg_empty">No arrivals today.</div>
                        <div class="o_hg_wl" t-foreach="state.data.arrivals" t-as="a" t-key="a.id">
                            <span class="o_hg_av" t-attf-style="background-color: {{ a.color }};" t-esc="a.initials"/>
                            <div class="o_hg_wlmain" t-on-click="() => this.openReservation(a.id)">
                                <div class="o_hg_wlname" t-esc="a.name"/>
                                <div class="o_hg_wlsub">Room <t t-esc="a.room"/> · <t t-esc="a.room_type"/> · <t t-esc="a.nights"/> night(s)</div>
                            </div>
                            <button class="o_hg_btn o_hg_btn_gold o_hg_btn_sm" t-on-click="() => this.doCheckIn(a.id)">Check In</button>
                        </div>

                        <div class="o_hg_sectlabel o_hg_serif o_hg_red o_hg_mt"><i class="fa fa-sign-out me-1"/>Departures Today <span class="o_hg_count" t-esc="state.data.departures.length"/></div>
                        <div t-if="!state.data.departures.length" class="o_hg_empty">No departures today.</div>
                        <div class="o_hg_wl" t-foreach="state.data.departures" t-as="dep" t-key="dep.id">
                            <span class="o_hg_av" t-attf-style="background-color: {{ dep.color }};" t-esc="dep.initials"/>
                            <div class="o_hg_wlmain" t-on-click="() => this.openReservation(dep.id)">
                                <div class="o_hg_wlname" t-esc="dep.name"/>
                                <div class="o_hg_wlsub">Room <t t-esc="dep.room"/> · Balance <t t-esc="money(dep.balance)"/></div>
                            </div>
                            <button class="o_hg_btn o_hg_btn_sm" t-on-click="() => this.doCheckOut(dep.id)">Check Out</button>
                        </div>
                    </div>

                    <!-- upcoming -->
                    <div class="o_hg_card o_hg_pad">
                        <div class="o_hg_rowbtw"><h3 class="o_hg_ctitle o_hg_serif">Upcoming Arrivals</h3><button class="o_hg_btn o_hg_btn_sm" t-on-click="() => this.openReservations()">View all</button></div>
                        <div t-if="!state.data.upcoming.length" class="o_hg_empty">No upcoming reservations.</div>
                        <div class="o_hg_wl" t-foreach="state.data.upcoming" t-as="u" t-key="u.id" t-on-click="() => this.openReservation(u.id)">
                            <div class="o_hg_datebadge"><div class="o_hg_d" t-esc="u.day"/><div class="o_hg_m" t-esc="u.month"/></div>
                            <div class="o_hg_wlmain">
                                <div class="o_hg_wlname" t-esc="u.name"/>
                                <div class="o_hg_wlsub"><t t-esc="u.room_type"/> · <t t-esc="u.nights"/> night(s)</div>
                            </div>
                            <span class="o_hg_pill o_hg_pill_conf">CONFIRMED</span>
                        </div>
                    </div>

                    <!-- recent bookings -->
                    <div class="o_hg_card o_hg_pad">
                        <div class="o_hg_rowbtw"><h3 class="o_hg_ctitle o_hg_serif">Recent Bookings</h3><button class="o_hg_btn o_hg_btn_gold o_hg_btn_sm" t-on-click="() => this.newReservation()"><i class="fa fa-plus me-1"/>New</button></div>
                        <div t-if="!state.data.recent_bookings.length" class="o_hg_empty">No bookings yet.</div>
                        <div class="o_hg_rb" t-foreach="state.data.recent_bookings" t-as="b" t-key="b.id" t-on-click="() => this.openReservation(b.id)">
                            <div>
                                <div class="o_hg_wlname"><t t-esc="b.name"/> <span class="o_hg_ref" t-esc="b.ref"/></div>
                                <div class="o_hg_wlsub"><t t-esc="b.check_in"/> → <t t-esc="b.check_out"/> · <t t-esc="money(b.amount)"/></div>
                            </div>
                            <span class="o_hg_pill"
                                  t-att-class="b.state === 'cancelled' or b.state === 'no_show' ? 'o_hg_pill_cancel' : 'o_hg_pill_conf'"
                                  t-esc="b.state_label"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
