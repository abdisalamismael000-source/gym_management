<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property -->
    <record id="property_grand_vista" model="hotel.property">
        <field name="name">Grand Vista Hotel</field>
        <field name="code">GV</field>
    </record>

    <!-- Distribution channels -->
    <record id="channel_direct" model="hotel.channel">
        <field name="name">Direct</field>
        <field name="channel_type">direct</field>
    </record>
    <record id="channel_booking" model="hotel.channel">
        <field name="name">Booking.com</field>
        <field name="channel_type">booking</field>
        <field name="commission_pct">15.0</field>
    </record>
    <record id="channel_expedia" model="hotel.channel">
        <field name="name">Expedia</field>
        <field name="channel_type">expedia</field>
        <field name="commission_pct">18.0</field>
    </record>

    <!-- Amenities -->
    <record id="amenity_wifi" model="hotel.amenity">
        <field name="name">Free Wi-Fi</field>
        <field name="icon">fa-wifi</field>
    </record>
    <record id="amenity_tv" model="hotel.amenity">
        <field name="name">Smart TV</field>
        <field name="icon">fa-tv</field>
    </record>
    <record id="amenity_ac" model="hotel.amenity">
        <field name="name">Air Conditioning</field>
        <field name="icon">fa-snowflake-o</field>
    </record>
    <record id="amenity_minibar" model="hotel.amenity">
        <field name="name">Minibar</field>
        <field name="icon">fa-glass</field>
    </record>
    <record id="amenity_safe" model="hotel.amenity">
        <field name="name">In-room Safe</field>
        <field name="icon">fa-lock</field>
    </record>

    <!-- Room-night service products -->
    <record id="product_standard_night" model="product.product">
        <field name="name">Standard Room Night</field>
        <field name="type">service</field>
        <field name="list_price">80.0</field>
    </record>
    <record id="product_deluxe_night" model="product.product">
        <field name="name">Deluxe Room Night</field>
        <field name="type">service</field>
        <field name="list_price">130.0</field>
    </record>
    <record id="product_suite_night" model="product.product">
        <field name="name">Suite Night</field>
        <field name="type">service</field>
        <field name="list_price">220.0</field>
    </record>

    <!-- Room types -->
    <record id="room_type_standard" model="hotel.room.type">
        <field name="name">Standard</field>
        <field name="code">STD</field>
        <field name="capacity">2</field>
        <field name="list_price">80.0</field>
        <field name="product_id" ref="product_standard_night"/>
        <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_tv'), ref('amenity_ac')])]"/>
    </record>
    <record id="room_type_deluxe" model="hotel.room.type">
        <field name="name">Deluxe</field>
        <field name="code">DLX</field>
        <field name="capacity">3</field>
        <field name="list_price">130.0</field>
        <field name="product_id" ref="product_deluxe_night"/>
        <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_tv'), ref('amenity_ac'), ref('amenity_minibar')])]"/>
    </record>
    <record id="room_type_suite" model="hotel.room.type">
        <field name="name">Suite</field>
        <field name="code">STE</field>
        <field name="capacity">4</field>
        <field name="list_price">220.0</field>
        <field name="product_id" ref="product_suite_night"/>
        <field name="amenity_ids" eval="[(6, 0, [ref('amenity_wifi'), ref('amenity_tv'), ref('amenity_ac'), ref('amenity_minibar'), ref('amenity_safe')])]"/>
    </record>

    <!-- Rooms -->
    <record id="room_101" model="hotel.room">
        <field name="name">101</field><field name="floor">1</field>
        <field name="room_type_id" ref="room_type_standard"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_102" model="hotel.room">
        <field name="name">102</field><field name="floor">1</field>
        <field name="room_type_id" ref="room_type_standard"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_103" model="hotel.room">
        <field name="name">103</field><field name="floor">1</field>
        <field name="room_type_id" ref="room_type_standard"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_201" model="hotel.room">
        <field name="name">201</field><field name="floor">2</field>
        <field name="room_type_id" ref="room_type_deluxe"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_202" model="hotel.room">
        <field name="name">202</field><field name="floor">2</field>
        <field name="room_type_id" ref="room_type_deluxe"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_203" model="hotel.room">
        <field name="name">203</field><field name="floor">2</field>
        <field name="room_type_id" ref="room_type_deluxe"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_301" model="hotel.room">
        <field name="name">301</field><field name="floor">3</field>
        <field name="room_type_id" ref="room_type_suite"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>
    <record id="room_302" model="hotel.room">
        <field name="name">302</field><field name="floor">3</field>
        <field name="room_type_id" ref="room_type_suite"/>
        <field name="property_id" ref="property_grand_vista"/>
    </record>

    <!-- Seasonal rate plan (high season) -->
    <record id="rate_deluxe_high" model="hotel.rate.plan">
        <field name="name">Deluxe — High Season</field>
        <field name="room_type_id" ref="room_type_deluxe"/>
        <field name="date_start" eval="(DateTime.today()).strftime('%Y-%m-01')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(months=2)).strftime('%Y-%m-28')"/>
        <field name="price">160.0</field>
        <field name="board_type">bb</field>
    </record>

    <!-- Guests -->
    <record id="guest_john" model="res.partner">
        <field name="name">John Carter</field>
        <field name="is_hotel_guest">True</field>
        <field name="email">john.carter@example.com</field>
        <field name="id_type">passport</field>
        <field name="id_number">X1234567</field>
    </record>
    <record id="guest_maria" model="res.partner">
        <field name="name">Maria Lopez</field>
        <field name="is_hotel_guest">True</field>
        <field name="email">maria.lopez@example.com</field>
        <field name="vip">True</field>
    </record>

    <!-- Sample reservations -->
    <record id="reservation_demo_1" model="hotel.reservation">
        <field name="partner_id" ref="guest_john"/>
        <field name="room_id" ref="room_201"/>
        <field name="check_in" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        <field name="check_out" eval="(DateTime.today() + relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        <field name="adults">2</field>
        <field name="board_type">bb</field>
        <field name="state">confirmed</field>
        <field name="source">website</field>
        <field name="channel_id" ref="channel_direct"/>
    </record>

    <!-- Sample guest service booking -->
    <record id="service_spa_demo" model="hotel.service.booking">
        <field name="partner_id" ref="guest_john"/>
        <field name="reservation_id" ref="reservation_demo_1"/>
        <field name="service_type">spa</field>
        <field name="quantity">1</field>
        <field name="price_unit">60.0</field>
        <field name="state">booked</field>
    </record>
    <record id="reservation_demo_2" model="hotel.reservation">
        <field name="partner_id" ref="guest_maria"/>
        <field name="room_id" ref="room_301"/>
        <field name="check_in" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="check_out" eval="(DateTime.today() + relativedelta(days=5)).strftime('%Y-%m-%d')"/>
        <field name="adults">2</field>
        <field name="children">1</field>
        <field name="state">confirmed</field>
        <field name="source">direct</field>
    </record>
</odoo>
